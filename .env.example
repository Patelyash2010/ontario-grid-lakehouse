# Copy this file to .env (never commit .env) and fill in the values.

# Where the SQL runs: duckdb (local Parquet copy of gold) or databricks (live warehouse)
DATA_BACKEND=duckdb

# Which model writes the SQL: gemini | azure | ollama | openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# Google Gemini API (free tier): aistudio.google.com > Get API key
GEMINI_API_KEY=

# Databricks (needed for scripts/export_gold.py and DATA_BACKEND=databricks)
# Host: from the workspace URL; HTTP path: SQL Warehouses > wh_powerbi > Connection details
DATABRICKS_HOST=adb-xxxxxxxxxxxx.x.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxx
DATABRICKS_TOKEN=

# Azure OpenAI / AI Foundry (later)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
