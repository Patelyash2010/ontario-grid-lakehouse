{
	"name": "pl_ingest_weather_daily",
	"properties": {
		"activities": [
			{
				"name": "foreach_city",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@json('[{\"city\":\"toronto\",\"lat\":\"43.65\",\"lon\":\"-79.38\"},{\"city\":\"ottawa\",\"lat\":\"45.42\",\"lon\":\"-75.70\"},{\"city\":\"london\",\"lat\":\"42.98\",\"lon\":\"-81.25\"}]')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "copy_weather_to_bronze",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET"
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_http_openmeteo",
									"type": "DatasetReference",
									"parameters": {
										"relativeUrl": {
											"value": "@concat('v1/forecast?latitude=', item().lat, '&longitude=', item().lon, '&hourly=temperature_2m,relative_humidity_2m&past_days=7&forecast_days=1&timezone=GMT')",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_bronze_file",
									"type": "DatasetReference",
									"parameters": {
										"folderPath": {
											"value": "@concat('weather/ingest_date=', formatDateTime(utcNow(), 'yyyy-MM-dd'))",
											"type": "Expression"
										},
										"fileName": {
											"value": "@concat('openmeteo_', item().city, '.json')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-10-23T08:21:13Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}